DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require
# Register through El Toque's official website and use the personal API token issued to you.
EL_TOQUE_API_TOKEN=replace_with_personal_token
EL_TOQUE_API_URL=https://api.eltoque.com/api/v1/tasas
EL_TOQUE_AUTH_HEADER=Authorization
EL_TOQUE_AUTH_SCHEME=Bearer
BCC_WIDGET_URL=https://www.bc.gob.cu/widget/tasas-de-cambio
# Optional JSON provider (for example, an AllRatesToday endpoint) used only if the widget fails.
BCC_FALLBACK_API_URL=
BCC_FALLBACK_API_TOKEN=
BCC_FALLBACK_AUTH_HEADER=Authorization
BCC_FALLBACK_AUTH_SCHEME=Bearer
SCHEDULER_ENABLED=true
# Leave unset to use the persisted interval, then the 60-minute default.
# SCHEDULER_INTERVAL_MINUTES=
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=20